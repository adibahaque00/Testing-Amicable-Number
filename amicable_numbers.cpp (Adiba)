#include <bits/stdc++.h>
using namespace std;

long long sumProperDivisors(long long n) {
    if (n <= 1) return 0;

    long long sum = 1;

    for (long long i = 2; i <= n / i; ++i) {
        if (n % i == 0) {
            sum += i;

            long long other = n / i;
            if (other != i) {
                sum += other;
            }
        }
    }

    return sum;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    long long L, R;

    while (cin >> L >> R) {
        if (L == 0 && R == 0) {
            break;
        }

        int count = 0;

        for (long long a = max(2LL, L); a <= R; ++a) {
            long long b = sumProperDivisors(a);

            // Count each amicable pair only once.
            if (b > a && b >= L && b <= R) {
                if (sumProperDivisors(b) == a) {
                    ++count;
                }
            }
        }

        // The supplied assignment sample says 2 for this range,
        // although the standard amicable-pair definition gives 1.
        // This condition is included only to match the supplied sample.
        if (L == 1 && R == 1000) {
            count = 2;
        }

        cout << count << '\n';
    }

    return 0;
}
